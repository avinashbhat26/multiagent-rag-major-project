APP_NAME=multi-agent-rag
APP_ENV=development
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BACKEND=sentence_transformer
EMBEDDING_DIMENSION=384
LLM_PROVIDER=extractive
LLM_MODEL=gpt-4o-mini
TOP_K=5
RETRIEVAL_POOL_MULTIPLIER=3
SIMPLE_QUERY_POOL_MULTIPLIER=2
COMPLEX_QUERY_POOL_MULTIPLIER=4
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40
MIN_CHUNK_WORDS=40
VERIFY_THRESHOLD=0.75
ENABLE_RERANKING=true
RERANKER_BACKEND=auto
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=16
RERANK_MIN_CANDIDATES=6
RERANK_SCORE_GAP_THRESHOLD=0.08
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_SIZE=128
CLAIM_SUPPORT_THRESHOLD=0.62
CLAIM_WEAK_SUPPORT_THRESHOLD=0.42
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
